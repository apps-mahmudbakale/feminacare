# ─── FeminaCare Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your actual values.

# Xano API Base URL (your workspace endpoint)
# Format: https://xxxx-xxxx-xxxx.xano.io/api:your_api_group_name
VITE_XANO_BASE_URL=https://your-xano-instance.xano.io/api:feminacare

# Paystack Public Key (get from https://dashboard.paystack.com/#/settings/developer)
# Use test key (pk_test_...) for development, live key (pk_live_...) for production
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
